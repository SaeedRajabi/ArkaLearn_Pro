<?xml version="1.0" encoding="UTF-8"?>
<!--
  Plesk / IIS + Node.js (Next.js standalone)
  Do NOT replace Plesk's httpPlatform handler — only extend verbs and optional rewrites.
  Plesk Node.js panel generates the main handler; this file adds DELETE/OPTIONS for SignalR.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <verbs allowUnlisted="true">
          <add verb="DELETE" allowed="true" />
          <add verb="OPTIONS" allowed="true" />
          <add verb="PATCH" allowed="true" />
          <add verb="PUT" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>
    <webSocket enabled="false" />
    <rewrite>
      <rules>
        <!-- Ensure SignalR long-polling reaches the Node process (Next.js server.js) -->
        <rule name="MeetingHubToNode" stopProcessing="true">
          <match url="^meetingHub(.*)$" ignoreCase="true" />
          <action type="Rewrite" url="server.js" />
        </rule>
        <!-- Fallback: all non-file requests to Next.js (if Plesk did not add this rule) -->
        <rule name="NextJsCatchAll" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
