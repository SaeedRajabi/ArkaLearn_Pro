<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ArkaLearnDesktop.App</RootNamespace>
    <AssemblyName>ArkaLearnDesktop</AssemblyName>
    <ApplicationTitle>آرکانرم افزار — دسکتاپ</ApplicationTitle>
    <Version>2.6.3</Version>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <FileVersion>2.6.3</FileVersion>
    <AssemblyVersion>2.6.3</AssemblyVersion>
    <Description>ArkaSoftware Course And Seminar Education Show</Description>
    <Copyright>ArkaSoftware - Copyright</Copyright>
  </PropertyGroup>

  <!-- Hardening for Release / publish (cannot make .NET undecompilable; raises the bar). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\arkasoftware-icon.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ArkaLearnDesktop.Application\ArkaLearnDesktop.Application.csproj" />
    <ProjectReference Include="..\ArkaLearnDesktop.Infrastructure\ArkaLearnDesktop.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
</Project>
