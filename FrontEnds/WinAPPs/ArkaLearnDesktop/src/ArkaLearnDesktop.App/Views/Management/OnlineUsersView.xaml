<UserControl x:Class="ArkaLearnDesktop.App.Views.Management.OnlineUsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="کاربران آنلاین دسکتاپ"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Margin="0,6,0,12"
                       Text="کاربران متصل به اپلیکیشن دسکتاپ در لحظه"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource RefreshIconButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,8,0" />
                <Button Content="مسدود دسترسی دسکتاپ"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding BlockUserCommand}"
                        Margin="0,0,8,0" />
                <TextBlock Margin="8,6,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding OnlineCountLabel}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
            <ListBox ItemsSource="{Binding Users}"
                     SelectedItem="{Binding SelectedUser}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource TextPrimaryBrush}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="شناسه:" />
                                    <Run Text="{Binding UserIdLabel, Mode=OneWay}" />
                                    <Run Text=" — نقش:" />
                                    <Run Text="{Binding Role, Mode=OneWay}" />
                                    <Run Text=" — نسخه:" />
                                    <Run Text="{Binding AppVersion, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap">
                                    <Run Text="دستگاه:" />
                                    <Run Text="{Binding DeviceId, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{Binding Status}" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding LastSeenLabel}"
                                           FontSize="11"
                                           HorizontalAlignment="Left"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
