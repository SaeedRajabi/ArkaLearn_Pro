<UserControl x:Class="ArkaLearnDesktop.App.Views.Management.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgPrimaryBrush}">
    <UserControl.Resources>
        <Style x:Key="StudentCardPagerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StudentIconActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StudentDangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource StudentIconActionButtonStyle}">
            <Setter Property="Foreground" Value="#F87171" />
            <Setter Property="BorderBrush" Value="#55F87171" />
        </Style>

        <Style x:Key="StudentListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Outer" Background="Transparent" CornerRadius="14" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="#223B82F6" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="#15243044" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="مدیریت دانشجویان"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Margin="0,6,0,14"
                       Text="جستجو، تأیید ثبت‌نام، حذف و مدیریت لایسنس دسکتاپ"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          Style="{StaticResource DarkComboBoxStyle}"
                          ItemsSource="{Binding CourseFilters}"
                          SelectedItem="{Binding SelectedCourseFilter}"
                          DisplayMemberPath="Title"
                          Margin="0,0,10,0" />

                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,10,0"
                         Padding="14,10"
                         FontSize="14"
                         Background="{StaticResource BgSurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderSubtleBrush}"
                         BorderThickness="1"
                         CaretBrush="{StaticResource TextPrimaryBrush}" />

                <Button Grid.Column="2"
                        Style="{StaticResource StudentIconActionButtonStyle}"
                        ToolTip="جستجو"
                        Command="{Binding SearchCommand}"
                        Margin="0,0,8,0"
                        Width="40"
                        Height="40">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" />
                </Button>

                <Button Grid.Column="3"
                        Style="{StaticResource RefreshIconButtonStyle}"
                        Command="{Binding RefreshCommand}" />
            </Grid>

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12">
                <ListBox ItemsSource="{Binding Students}"
                         SelectedItem="{Binding SelectedStudent}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource StudentListBoxItemStyle}"
                         Foreground="{StaticResource TextPrimaryBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgElevatedBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14,12"
                                    Margin="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="46"
                                            Height="46"
                                            CornerRadius="23"
                                            Background="#223B82F6"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initials}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="15"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}">
                                            <Run Text="{Binding Email, Mode=OneWay}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{Binding UserName, Mode=OneWay}" />
                                        </TextBlock>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Border Background="#223B82F6"
                                                    CornerRadius="8"
                                                    Padding="10,4"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding CourseTitle}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                            <Border Background="#22000000"
                                                    CornerRadius="8"
                                                    Padding="10,4"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                            <Border Background="#22000000"
                                                    CornerRadius="8"
                                                    Padding="10,4">
                                                <TextBlock Text="{Binding EnrollmentDateTime}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource StudentIconActionButtonStyle}"
                                                ToolTip="تأیید ثبت‌نام"
                                                Visibility="{Binding ApproveVisibility}"
                                                Command="{Binding DataContext.ApproveEnrollmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Path Width="15" Height="15" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" />
                                        </Button>
                                        <Button Style="{StaticResource StudentDangerIconButtonStyle}"
                                                ToolTip="حذف دانشجو"
                                                Margin="0"
                                                Command="{Binding DataContext.RemoveStudentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Path Width="15" Height="15" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14">
                <Grid>
                    <DockPanel LastChildFill="True" Visibility="{Binding LicensePanelVisibility}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="True">
                            <Button DockPanel.Dock="Left"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="ایجاد لایسنس دسکتاپ"
                                    Command="{Binding CreateLicenseCommand}"
                                    Margin="0,0,10,0"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                                          Fill="White"
                                          Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" />
                                    <TextBlock Text="ایجاد لایسنس" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding SelectedStudentLabel}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </DockPanel>

                        <ListBox ItemsSource="{Binding Licenses}"
                                 SelectedItem="{Binding SelectedLicense}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 HorizontalContentAlignment="Stretch"
                                 ItemContainerStyle="{StaticResource StudentListBoxItemStyle}"
                                 Foreground="{StaticResource TextPrimaryBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgElevatedBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="14"
                                            Margin="2">
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Left"
                                                        Background="#22000000"
                                                        CornerRadius="8"
                                                        Padding="10,4"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusLabel}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding CourseTitle}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                            </DockPanel>

                                            <Border Margin="0,12,0,0"
                                                    Background="{StaticResource BgSurfaceBrush}"
                                                    CornerRadius="10"
                                                    Padding="10,8">
                                                <TextBlock Text="{Binding LicenseKey}"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>

                                            <TextBlock Margin="0,8,0,12"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}">
                                                <Run Text="انقضا:" />
                                                <Run Text=" " />
                                                <Run Text="{Binding ExpiresLabel, Mode=OneWay}" />
                                            </TextBlock>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Button Style="{StaticResource StudentIconActionButtonStyle}"
                                                        ToolTip="کپی کلید"
                                                        Command="{Binding DataContext.CopyLicenseKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Width="14" Height="14" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" />
                                                </Button>
                                                <Button Style="{StaticResource StudentIconActionButtonStyle}"
                                                        ToolTip="تمدید لایسنس"
                                                        Command="{Binding DataContext.RenewLicenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Width="14" Height="14" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M12,6V9L16,5L12,1V4A8,8 0 0,0 4,12C4,13.57 4.46,15.03 5.24,16.26L6.7,14.8C6.25,13.97 6,13 6,12A6,6 0 0,1 12,6M18.76,7.74L17.3,9.2C17.74,10.04 18,11 18,12A6,6 0 0,1 12,18V15L8,19L12,23V20A8,8 0 0,0 20,12C20,10.43 19.54,8.97 18.76,7.74Z" />
                                                </Button>
                                                <Button Style="{StaticResource StudentIconActionButtonStyle}"
                                                        ToolTip="صدور کلید جدید"
                                                        Command="{Binding DataContext.RegenerateLicenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Width="14" Height="14" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M12,18A6,6 0 0,1 6,12C6,11 6.25,10.03 6.7,9.2L5.24,7.74C4.46,8.97 4,10.43 4,12A8,8 0 0,0 12,20V23L16,19L12,15M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12C18,13 17.75,13.97 17.3,14.8L18.76,16.26C19.54,15.03 20,13.57 20,12A8,8 0 0,0 12,4Z" />
                                                </Button>
                                                <Button Style="{StaticResource StudentDangerIconButtonStyle}"
                                                        ToolTip="غیرفعال کردن لایسنس"
                                                        Margin="0"
                                                        Command="{Binding DataContext.RevokeLicenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Width="14" Height="14" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12C4,13.85 4.63,15.55 5.68,16.91L16.91,5.68C15.55,4.63 13.85,4 12,4M12,20A8,8 0 0,0 20,12C20,10.15 19.37,8.45 18.32,7.09L7.09,18.32C8.45,19.37 10.15,20 12,20Z" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <TextBlock Text="برای مشاهده لایسنس‌ها، یک دانشجو را از فهرست انتخاب کنید."
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="12"
                               Foreground="{StaticResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedStudent}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="12,10"
                CornerRadius="14"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource StudentCardPagerButtonStyle}"
                        ToolTip="صفحه قبل"
                        Command="{Binding PreviousPageCommand}"
                        Margin="0,0,10,0">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
                </Button>

                <Border MinWidth="180"
                        Padding="16,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource BgElevatedBrush}"
                        CornerRadius="10">
                    <TextBlock Text="{Binding PageLabel}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Padding="0,10"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>

                <Button Style="{StaticResource StudentCardPagerButtonStyle}"
                        ToolTip="صفحه بعد"
                        Command="{Binding NextPageCommand}"
                        Margin="10,0,0,0">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
