<UserControl x:Class="ArkaLearnDesktop.App.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1200"
             Background="{StaticResource BgPrimaryBrush}"
             Loaded="LoginView_OnLoaded"
             PreviewKeyDown="LoginView_OnPreviewKeyDown">
    <Grid>
        <Border Width="420"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="32">
            <StackPanel>
                <TextBlock Text="آرکانرم افزار"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="ورود به نسخه دسکتاپ"
                           Margin="0,6,0,24"
                           FontSize="14"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" />

                <StackPanel Visibility="{Binding UserNameFieldVisibility}">
                    <TextBlock Text="نام کاربری یا ایمیل"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="UserNameBox"
                             Text="{Binding UserNameOrEmail, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBoxStyle}"
                             Margin="0,0,0,16" />
                </StackPanel>

                <Border Visibility="{Binding LockedUserVisibility}"
                        Background="{StaticResource BgElevatedBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="{StaticResource AccentBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                            <Path Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Fill="White"
                                  Data="{StaticResource PersonIconGeometry}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <TextBlock Text="ورود با حساب"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="{Binding UserNameOrEmail}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       TextAlignment="Right"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="40" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource ChangeUserIconButtonStyle}"
                                Command="{Binding ChangeUserCommand}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="تغییر کاربر" />
                    </Grid>
                </Border>

                <TextBlock Text="رمز عبور"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource DarkPasswordBoxStyle}"
                             PasswordChanged="PasswordBox_OnPasswordChanged"
                             IsEnabled="{Binding IsInteractionEnabled}"
                             Margin="0,0,0,8" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#F87171"
                           TextWrapping="Wrap"
                           Margin="0,8,0,8"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LoginCommand}"
                        IsDefault="True"
                        Margin="0,12,0,0"
                        Height="44"
                        MinWidth="120">
                    <Grid MinHeight="20">
                        <TextBlock Text="ورود"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Ellipse Width="16"
                                     Height="16"
                                     Stroke="White"
                                     StrokeThickness="2"
                                     StrokeDashArray="3,1.5"
                                     RenderTransformOrigin="0.5,0.5"
                                     Margin="0,0,8,0">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="LoginSpinnerRotate" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0"
                                                                 To="360"
                                                                 Duration="0:0:0.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="در حال ورود…"
                                       VerticalAlignment="Center"
                                       Foreground="White" />
                        </StackPanel>
                    </Grid>
                </Button>

                <TextBlock Text="برای ادامه به اتصال اینترنت و حساب کاربری آرکانرم افزار نیاز دارید."
                           Margin="0,16,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
