<UserControl x:Class="ArkaLearnDesktop.App.Views.About.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">
        <StackPanel MaxWidth="720" Margin="0,8,0,24">
            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                <Button DockPanel.Dock="Left"
                        Content="بروزرسانی"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="درباره ما"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="معرفی شرکت آرکا نرم‌افزار، تیم و راه‌های ارتباطی"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding StatusMessage}"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}" />

            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding HeroTitle}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding HeroSubtitle}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Margin="0,14,0,0"
                               Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="نسخه برنامه: " />
                        <Run Text="{Binding AppVersion, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16"
                    Visibility="{Binding IntroVisibility}">
                <StackPanel>
                    <TextBlock Text="{Binding IntroTitle}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding IntroBody}"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Right"
                               TextAlignment="Left"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               LineHeight="24"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16"
                    Visibility="{Binding MissionVisibility}">
                <StackPanel>
                    <TextBlock Text="{Binding MissionTitle}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding MissionBody}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               LineHeight="24"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16"
                    Visibility="{Binding VisionVisibility}">
                <StackPanel>
                    <TextBlock Text="{Binding VisionTitle}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding VisionBody}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               LineHeight="24"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16"
                    Visibility="{Binding ValuesVisibility}">
                <StackPanel>
                    <TextBlock Text="{Binding ValuesTitle}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding ValuesBody}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               LineHeight="24"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16"
                    Visibility="{Binding TeamVisibility}">
                <StackPanel>
                    <TextBlock Text="{Binding TeamTitle}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding TeamBody}"
                               Margin="0,8,0,12"
                               TextAlignment="Left"
                               TextWrapping="Wrap"
                               LineHeight="24"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <ItemsControl ItemsSource="{Binding TeamMembers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="12"
                                        CornerRadius="10"
                                        Background="{StaticResource BgElevatedBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FullName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding SkillTitle}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="لینکدین"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding LinkedInVisibility}"
                                                    Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding LinkedInUrl}" />
                                            <Button Content="گیت‌هاب"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding GithubVisibility}"
                                                    Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding GithubUrl}" />
                                            <Button Content="اینستاگرام"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding InstagramVisibility}"
                                                    Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding InstagramUrl}" />
                                            <Button Content="وب‌سایت"
                                                    Visibility="{Binding WebsiteVisibility}"
                                                    Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding WebsiteUrl}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding ContactSectionTitle}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding PhoneVisibility}">
                        <TextBlock Text="تلفن"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Phone}"
                                   Margin="0,4,0,0"
                                   FontSize="16"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding EmailVisibility}">
                        <TextBlock Text="ایمیل"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Email}"
                                   Margin="0,4,0,0"
                                   FontSize="16"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding AddressVisibility}">
                        <TextBlock Text="آدرس"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Address}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding SalesVisibility}">
                        <TextBlock Text="پشتیبانی فروش"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding SalesPhone}"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding SalesEmail}"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding SocialVisibility}">
                        <TextBlock Text="شبکه‌های اجتماعی"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="اینستاگرام"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding InstagramVisibility}"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding InstagramUrl}" />
                            <Button Content="لینکدین"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding LinkedInVisibility}"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding LinkedInUrl}" />
                            <Button Content="توییتر / X"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding TwitterVisibility}"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding TwitterUrl}" />
                            <Button Content="فیسبوک"
                                    Visibility="{Binding FacebookVisibility}"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding FacebookUrl}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
