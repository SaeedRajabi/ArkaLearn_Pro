<UserControl x:Class="ArkaLearnDesktop.App.Views.Player.SecurePlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContextChanged="SecurePlayerView_OnDataContextChanged"
             Loaded="SecurePlayerView_OnLoaded"
             Background="{StaticResource BgPrimaryBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <SolidColorBrush x:Key="PlayerAccentBrush" Color="#C026D3" />
        <SolidColorBrush x:Key="PlayerControlFgBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="PlayerBarBgBrush" Color="#E6000000" />

        <Style x:Key="PlayerIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource PlayerControlFgBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource BgPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogPrimaryIconButtonStyle" TargetType="Button" BasedOn="{StaticResource CatalogIconButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PlayerAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PlayerAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="PlayerProgressSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="18" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="18">
                            <Border Height="3"
                                    Background="#44FFFFFF"
                                    CornerRadius="1.5"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{StaticResource PlayerAccentBrush}"
                                                        Height="3"
                                                        CornerRadius="1.5"
                                                        VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Focusable="False" IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource PlayerAccentBrush}"
                                                         Stroke="White"
                                                         StrokeThickness="1.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerVolumeSliderStyle" TargetType="Slider" BasedOn="{StaticResource PlayerProgressSliderStyle}">
            <Setter Property="Width" Value="90" />
            <Setter Property="Height" Value="16" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0" x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" x:Name="HeaderRowDef" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderPanel" Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="پخش دوره‌های لایسنس‌دار"
                       TextAlignment="Left"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Margin="0,6,0,0"
                       TextAlignment="Left"
                       Text="ابتدا استاد را انتخاب کنید، سپس لایسنس همان دوره را وارد کنید. هر لایسنس فقط همان دوره را باز می‌کند."
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" x:Name="MainSplit">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CatalogColumn" Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CatalogPanel"
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Border Visibility="{Binding LicenseGateVisibility}"
                                Background="{StaticResource BgPrimaryBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding LicenseGateTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,6" />
                                <TextBox Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"
                                         Padding="8,6"
                                         Background="{StaticResource BgSurfaceBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="{StaticResource BorderSubtleBrush}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="تأیید لایسنس"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding ValidateLicenseCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="انصراف"
                                            Command="{Binding CancelAddLicenseCommand}"
                                            Visibility="{Binding CancelAddLicenseVisibility}"
                                            Padding="10,6" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding CatalogVisibility}">
                            <DockPanel Margin="0,0,0,12" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <!-- تغییر / حذف لایسنس -->
                                    <Button Style="{StaticResource CatalogIconButtonStyle}"
                                            Command="{Binding ClearLicenseCommand}"
                                            ToolTip="تغییر یا حذف لایسنس فعلی"
                                            Margin="0,0,8,0">
                                        <Path Width="16" Height="16" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M9,2 H15 L16.5,5 H21 V7 H3 V5 H7.5 Z M5,8 H19 V21 C19,21.6 18.6,22 18,22 H6 C5.4,22 5,21.6 5,21 Z M9,11 V18 H11 V11 Z M13,11 V18 H15 V11 Z" />
                                    </Button>
                                    <!-- افزودن لایسنس جدید -->
                                    <Button Style="{StaticResource CatalogPrimaryIconButtonStyle}"
                                            Command="{Binding ShowAddLicenseCommand}"
                                            ToolTip="افزودن لایسنس جدید">
                                        <Path Width="16" Height="16" Stretch="Uniform"
                                              Fill="White"
                                              Data="M11,2 H13 V11 H22 V13 H13 V22 H11 V13 H2 V11 H11 Z" />
                                    </Button>
                                </StackPanel>
                                <!-- بازگشت -->
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource CatalogIconButtonStyle}"
                                        Command="{Binding GoBackCatalogCommand}"
                                        Visibility="{Binding GoBackButtonVisibility}"
                                        ToolTip="بازگشت به مرحله قبل">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M14,2 L4,12 L14,22 L16.5,19.5 L9,12 L16.5,4.5 Z" />
                                </Button>
                            </DockPanel>

                            <TextBlock Text="{Binding CatalogStepTitle}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}" />

                            <ListBox ItemsSource="{Binding Teachers}"
                                     SelectedItem="{Binding SelectedTeacher}"
                                     Visibility="{Binding TeachersStepVisibility}"
                                     MinHeight="180"
                                     MaxHeight="420"
                                     Background="Transparent"
                                     BorderThickness="1"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Margin="0,0,0,8"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding TeacherName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CourseCountLabel}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ListBox ItemsSource="{Binding TeacherCourses}"
                                     SelectedItem="{Binding SelectedCourse}"
                                     Visibility="{Binding CoursesStepVisibility}"
                                     MinHeight="180"
                                     MaxHeight="420"
                                     Background="Transparent"
                                     BorderThickness="1"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Margin="0,0,0,8"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CourseTitle}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CourseTitle}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Visibility="{Binding CourseContentStepVisibility}"
                                       Text="{Binding ActiveCourseTitle, StringFormat=دوره فعال: {0}}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,8"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ActiveCourseTitle}" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer x:Name="CurriculumScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  PanningMode="VerticalOnly"
                                  Focusable="True"
                                  MinHeight="80"
                                  Margin="0,0,0,4"
                                  FlowDirection="RightToLeft"
                                  Visibility="{Binding CourseContentStepVisibility}">
                        <ItemsControl ItemsSource="{Binding CurriculumSections}"
                                      ScrollViewer.CanContentScroll="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              Margin="0,0,0,8"
                                              FlowDirection="RightToLeft"
                                              Expanded="CurriculumExpander_OnExpandedCollapsed"
                                              Collapsed="CurriculumExpander_OnExpandedCollapsed"
                                              Foreground="{StaticResource TextPrimaryBrush}">
                                        <Expander.Header>
                                            <StackPanel FlowDirection="RightToLeft">
                                                <TextBlock Text="{Binding Title}"
                                                           TextAlignment="Right"
                                                           TextWrapping="Wrap"
                                                           FontWeight="SemiBold"
                                                           FlowDirection="RightToLeft" />
                                                <ItemsControl ItemsSource="{Binding Materials}"
                                                              Visibility="{Binding HasMaterials, Converter={StaticResource BoolToVisibilityConverter}}"
                                                              Margin="0,5,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Path Grid.Column="0"
                                                                      Width="14" Height="16"
                                                                      Margin="0,0,6,0"
                                                                      Stretch="Uniform"
                                                                      Fill="{StaticResource TextMutedBrush}"
                                                                      Data="M5,2 H14 L19,7 V22 H5 Z M14,2 V7 H19 M8,12 H16 M8,16 H16" />
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontSize="11"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding OriginalFileName}" />
                                                                    <TextBlock Text="{Binding FileSizeLabel}"
                                                                               FontSize="9"
                                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                                </StackPanel>
                                                                <Button Grid.Column="2"
                                                                        Style="{StaticResource CatalogIconButtonStyle}"
                                                                        Width="28" Height="28" Padding="6"
                                                                        Margin="6,0,0,0"
                                                                        ToolTip="دانلود فایل"
                                                                        Command="{Binding DataContext.DownloadMaterialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <Path Width="13" Height="13"
                                                                          Stretch="Uniform"
                                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                          Data="M11,2 H13 V13 L17,9 L19,11 L12,18 L5,11 L7,9 L11,13 Z M4,20 H20 V22 H4 Z" />
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander.Header>
                                        <ListBox ItemsSource="{Binding Lessons}"
                                                 SelectedItem="{Binding DataContext.SelectedLesson, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 FlowDirection="RightToLeft"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.CanContentScroll="False"
                                                 PreviewMouseWheel="CurriculumNested_OnPreviewMouseWheel">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                                                    <Setter Property="Padding" Value="6,4" />
                                                    <Setter Property="Margin" Value="0,1" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="FlowDirection" Value="RightToLeft" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.42" />
                                                            <Setter Property="Cursor" Value="Arrow" />
                                                            <Setter Property="Focusable" Value="False" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" FlowDirection="RightToLeft">
                                                            <TextBlock Text="{Binding Title}"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Center"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       TextAlignment="Left"
                                                                       FlowDirection="RightToLeft" />
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       TextWrapping="Wrap"
                                                                       TextAlignment="Right"
                                                                       FlowDirection="RightToLeft">
                                                                <Run Text="{Binding DurationLabel, Mode=OneWay, StringFormat=مدت: {0}}" />
                                                                <Run Text=" — " />
                                                                <Run Text="{Binding StatusLabel, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <ItemsControl ItemsSource="{Binding Materials}"
                                                                          Visibility="{Binding HasMaterials, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                          Margin="0,5,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,2">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Path Grid.Column="0"
                                                                                  Width="13" Height="15"
                                                                                  Margin="0,0,6,0"
                                                                                  Stretch="Uniform"
                                                                                  Fill="{StaticResource TextMutedBrush}"
                                                                                  Data="M5,2 H14 L19,7 V22 H5 Z M14,2 V7 H19 M8,12 H16 M8,16 H16" />
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding DisplayName}"
                                                                                           FontSize="11"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           ToolTip="{Binding OriginalFileName}" />
                                                                                <TextBlock Text="{Binding FileSizeLabel}"
                                                                                           FontSize="9"
                                                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                                            </StackPanel>
                                                                            <Button Grid.Column="2"
                                                                                    Style="{StaticResource CatalogIconButtonStyle}"
                                                                                    Width="28" Height="28" Padding="6"
                                                                                    Margin="6,0,0,0"
                                                                                    ToolTip="دانلود فایل"
                                                                                    Command="{Binding DataContext.DownloadMaterialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}">
                                                                                <Path Width="13" Height="13"
                                                                                      Stretch="Uniform"
                                                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                      Data="M11,2 H13 V13 L17,9 L19,11 L12,18 L5,11 L7,9 L11,13 Z M4,20 H20 V22 H4 Z" />
                                                                            </Button>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Style="{StaticResource CatalogPrimaryIconButtonStyle}"
                                                                Width="32"
                                                                Height="32"
                                                                Padding="6"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip="پخش درس"
                                                                Command="{Binding DataContext.PlayLessonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Visibility="{Binding ShowPlayButton, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Path Width="12" Height="12" Stretch="Uniform"
                                                                  Fill="White"
                                                                  Data="M6,2 L20,12 L6,22 Z" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border x:Name="VideoHost"
                    Grid.Column="1"
                    Background="#000000"
                    CornerRadius="12"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    MouseEnter="VideoHost_OnMouseEnter"
                    MouseLeave="VideoHost_OnMouseLeave"
                    MouseMove="VideoHost_OnMouseMove"
                    MouseLeftButtonDown="VideoHost_OnMouseLeftButtonDown"
                    PreviewKeyDown="VideoHost_OnPreviewKeyDown"
                    Focusable="True">
                <Grid>
                    <MediaElement x:Name="MediaPlayer"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Manual"
                                  Stretch="Uniform"
                                  ScrubbingEnabled="True"
                                  MediaOpened="MediaPlayer_OnMediaOpened"
                                  MediaEnded="MediaPlayer_OnMediaEnded"
                                  BufferingStarted="MediaPlayer_OnBufferingStarted"
                                  BufferingEnded="MediaPlayer_OnBufferingEnded"
                                  MediaFailed="MediaPlayer_OnMediaFailed" />

                    <!-- Dynamic course watermark -->
                    <Border x:Name="VideoWatermark"
                            HorizontalAlignment="{Binding WatermarkHorizontalAlignment}"
                            VerticalAlignment="{Binding WatermarkVerticalAlignment}"
                            Margin="{Binding WatermarkMargin}"
                            Padding="6,4"
                            Background="#66000000"
                            CornerRadius="4"
                            Opacity="{Binding WatermarkOpacity}"
                            IsHitTestVisible="False"
                            FlowDirection="LeftToRight"
                            RenderTransformOrigin="0.5,0.5">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18"
                                    Height="18"
                                    CornerRadius="3"
                                    Background="#C026D3"
                                    Margin="0,0,6,0"
                                    Visibility="{Binding ShowPlatformLogo, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Arka"
                                           FontSize="6"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding WatermarkText}"
                                       FontSize="{Binding WatermarkFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding WatermarkForegroundBrush}"
                                       TextWrapping="Wrap"
                                       MaxWidth="320" />
                        </StackPanel>
                    </Border>

                    <!-- Progressive buffering / preparing overlay -->
                    <Border Background="#88000000"
                            Visibility="{Binding VideoLoadingVisibility}"
                            IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Grid Width="72" Height="72" Margin="0,0,0,14">
                                <Ellipse Width="72" Height="72"
                                         Stroke="#33FFFFFF"
                                         StrokeThickness="5" />
                                <Ellipse x:Name="BufferSpinnerRing"
                                         Width="72" Height="72"
                                         Stroke="{StaticResource PlayerAccentBrush}"
                                         StrokeThickness="5"
                                         StrokeDashArray="2.2 1.4"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="BufferSpinnerRing"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.9" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="{Binding BufferProgressText}"
                                           Foreground="White"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasBufferProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                            <TextBlock Text="{Binding BufferingStatusText}"
                                       Foreground="#F3F4F6"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Playback / catalog errors as overlay on the video surface -->
                    <Border Background="#B3000000"
                            CornerRadius="12"
                            Visibility="{Binding PlaybackErrorVisibility}"
                            FlowDirection="RightToLeft">
                        <Border MaxWidth="420"
                                Margin="24"
                                Padding="20,18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#F11F2937"
                                BorderBrush="#55FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="خطا"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="White"
                                           TextAlignment="Right"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="{Binding PlaybackErrorMessage}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Right"
                                           Foreground="#E5E7EB"
                                           LineHeight="22"
                                           Margin="0,0,0,16" />
                                <Button Content="بستن"
                                        Command="{Binding DismissPlaybackErrorCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="16,8"
                                        Cursor="Hand"
                                        Background="{StaticResource PlayerAccentBrush}"
                                        Foreground="White"
                                        BorderThickness="0" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <Border x:Name="ControlsOverlay"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource PlayerBarBgBrush}"
                            Padding="10,6,10,10"
                            Opacity="0"
                            IsHitTestVisible="False"
                            FlowDirection="LeftToRight"
                            MouseEnter="ControlsOverlay_OnMouseEnter"
                            MouseLeave="ControlsOverlay_OnMouseLeave">
                        <StackPanel>
                            <!-- Progress -->
                            <Slider x:Name="ProgressSlider"
                                    Style="{StaticResource PlayerProgressSliderStyle}"
                                    Margin="4,2,4,8"
                                    IsMoveToPointEnabled="True"
                                    PreviewMouseLeftButtonDown="ProgressSlider_OnPreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="ProgressSlider_OnPreviewMouseLeftButtonUp"
                                    ValueChanged="ProgressSlider_OnValueChanged" />

                            <Grid Margin="2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: time + extras -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="CurrentTimeText"
                                               Text="00:00:00"
                                               Foreground="{StaticResource PlayerControlFgBrush}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <Button Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTip="نمایش / مخفی لیست دروس"
                                            Click="ToggleCatalogButton_OnClick"
                                            Margin="0,0,2,0">
                                        <Path Width="16" Height="12" Stretch="Uniform"
                                              Fill="{StaticResource PlayerControlFgBrush}"
                                              Data="M2,2 H22 V5 H2 Z M2,10.5 H22 V13.5 H2 Z M2,19 H22 V22 H2 Z" />
                                    </Button>
                                    <Button Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTip="تمام‌صفحه"
                                            Click="FullscreenButton_OnClick"
                                            Margin="0,0,2,0">
                                        <Path Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{StaticResource PlayerControlFgBrush}"
                                              StrokeThickness="1.6"
                                              Fill="Transparent"
                                              Data="M2,8 V2 H8 M16,2 H22 V8 M22,16 V22 H16 M8,22 H2 V16" />
                                    </Button>
                                </StackPanel>

                                <!-- Center: transport -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTip="درس قبلی"
                                            Click="PreviousLessonButton_OnClick"
                                            Margin="0,0,4,0">
                                        <Path Width="16" Height="14" Stretch="Uniform"
                                              Fill="{StaticResource PlayerControlFgBrush}"
                                              Data="M4,2 V22 H7 V2 Z M20,2 L8,12 L20,22 Z" />
                                    </Button>
                                    <Button x:Name="PlayPauseButton"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTip="پخش / توقف موقت"
                                            Click="PlayPauseButton_OnClick"
                                            Margin="4,0">
                                        <Path x:Name="PlayPauseIcon"
                                              Width="18" Height="18" Stretch="Uniform"
                                              Fill="{StaticResource PlayerControlFgBrush}"
                                              Data="M6,2 L20,12 L6,22 Z" />
                                    </Button>
                                    <Button Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTip="درس بعدی"
                                            Click="NextLessonButton_OnClick"
                                            Margin="0,0,4,0">
                                        <Path Width="16" Height="14" Stretch="Uniform"
                                              Fill="{StaticResource PlayerControlFgBrush}"
                                              Data="M4,2 L16,12 L4,22 Z M17,2 V22 H20 V2 Z" />
                                    </Button>
                                    <Button Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTip="توقف"
                                            Click="StopButton_OnClick">
                                        <Path Width="14" Height="14" Stretch="Uniform"
                                              Fill="{StaticResource PlayerControlFgBrush}"
                                              Data="M4,4 H20 V20 H4 Z" />
                                    </Button>
                                </StackPanel>

                                <!-- Right: duration + volume -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="16" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          Fill="{StaticResource PlayerControlFgBrush}"
                                          Data="M3,8 V16 H8 L14,21 V3 L8,8 Z M17,9 C18.2,10 18.2,14 17,15 M19.5,7 C21.5,9 21.5,15 19.5,17" />
                                    <Slider x:Name="VolumeSlider"
                                            Style="{StaticResource PlayerVolumeSliderStyle}"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="80"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0"
                                            ValueChanged="VolumeSlider_OnValueChanged"
                                            ToolTip="بلندی صدا" />
                                    <TextBlock x:Name="DurationText"
                                               Text="00:00:00"
                                               Foreground="{StaticResource PlayerControlFgBrush}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
