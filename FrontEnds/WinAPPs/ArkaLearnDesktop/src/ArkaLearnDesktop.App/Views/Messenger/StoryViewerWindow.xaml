<Window x:Class="ArkaLearnDesktop.App.Views.Messenger.StoryViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ArkaLearnDesktop.App.Converters"
        Title="استوری"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#CC000000"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <converters:StoryProgressWidthConverter x:Key="StoryProgressWidthConverter" />
    </Window.Resources>
    <Grid MouseLeftButtonDown="Root_MouseLeftButtonDown"
          MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl x:Name="ProgressItems"
                          ItemsSource="{Binding ProgressSegments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="3" Margin="2,0">
                            <Border Background="#55FFFFFF" CornerRadius="2" />
                            <Border Background="White"
                                    CornerRadius="2"
                                    HorizontalAlignment="Left">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource StoryProgressWidthConverter}">
                                        <Binding Path="Progress" />
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Grid.Column="1"
                    Margin="16,0,0,0"
                    Padding="10,4"
                    Content="✕"
                    Click="Close_Click"
                    Background="#66000000"
                    Foreground="White"
                    BorderThickness="0" />
        </Grid>

        <Grid Grid.Row="1" Margin="24,0">
            <Image x:Name="StoryImage"
                   Stretch="Uniform"
                   Visibility="Collapsed" />
            <MediaElement x:Name="StoryVideo"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          Stretch="Uniform"
                          Visibility="Collapsed"
                          MediaOpened="StoryVideo_MediaOpened"
                          MediaEnded="StoryVideo_MediaEnded"
                          MediaFailed="StoryVideo_MediaFailed" />
            <TextBlock x:Name="LoadingText"
                       Text="در حال بارگذاری..."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="16" />
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="24,12,24,24">
            <TextBlock x:Name="TeacherNameText"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White" />
            <TextBlock x:Name="CaptionText"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="#E5E7EB" />
            <TextBlock Margin="0,10,0,0"
                       Text="برای توقف، دکمه ماوس را نگه دارید"
                       FontSize="12"
                       Foreground="#9CA3AF" />
        </StackPanel>
    </Grid>
</Window>
