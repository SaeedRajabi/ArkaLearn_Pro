<Window x:Class="ArkaLearnDesktop.App.Views.Messenger.PublishStoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="انتشار استوری"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        MinWidth="420"
        Background="{StaticResource BgPrimaryBrush}">
    <Border Margin="20"
            Padding="20"
            Background="{StaticResource BgSurfaceBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <StackPanel>
            <TextBlock Text="انتشار استوری"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Margin="0,8,0,16"
                       Text="یک تصویر یا ویدیو انتخاب کنید و در صورت نیاز توضیح کوتاه بنویسید."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}" />

            <TextBox x:Name="CaptionBox"
                     MinHeight="72"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="{StaticResource BgPrimaryBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource BorderSubtleBrush}" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="انتخاب فایل"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Browse_Click" />
                <TextBlock x:Name="SelectedFileText"
                           Margin="12,6,0,0"
                           VerticalAlignment="Center"
                           Text="فایلی انتخاب نشده"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Foreground="#FCA5A5" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,16,0,0">
                <Button x:Name="PublishButton"
                        Content="انتشار"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Publish_Click"
                        Margin="0,0,8,0" />
                <Button Content="انصراف"
                        Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
