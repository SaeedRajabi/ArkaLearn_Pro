<Window x:Class="ArkaLearnDesktop.App.Views.Messenger.NewTopicDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="موضوع جدید پشتیبانی"
        Width="480"
        Height="520"
        MinWidth="420"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <StackPanel>
                <TextBlock Text="ایجاد موضوع جدید"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16" />

                <TextBlock Text="استاد"
                           Margin="0,0,0,6"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <ComboBox x:Name="TeacherCombo"
                          Style="{StaticResource DarkComboBoxStyle}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="TeacherUserId"
                          Margin="0,0,0,14" />

                <TextBlock Text="موضوع"
                           Margin="0,0,0,6"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBox x:Name="SubjectBox"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Margin="0,0,0,14" />

                <TextBlock Text="پیام اولیه"
                           Margin="0,0,0,6"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBox x:Name="InitialMessageBox"
                         Style="{StaticResource DarkTextBoxStyle}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="140"
                         Height="160"
                         VerticalContentAlignment="Top"
                         Margin="0,0,0,12" />

                <TextBlock x:Name="StatusText"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,12,0,0">
            <Button x:Name="CreateButton"
                    Content="ایجاد موضوع"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Create_Click"
                    Margin="0,0,8,0"
                    Padding="14,8" />
            <Button Content="انصراف"
                    Click="Cancel_Click"
                    Padding="14,8"
                    Background="{StaticResource BgElevatedBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
