<UserControl x:Class="ArkaLearnDesktop.App.Views.Shell.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             d:DesignHeight="700"
             d:DesignWidth="1100">

    <UserControl.Resources>
        <Style x:Key="ShellIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgElevatedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarPanel"
                Grid.Column="0"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1,0,0,0"
                ClipToBounds="True">
            <DockPanel>
                <!-- Brand -->
                <Grid DockPanel.Dock="Top" Margin="10,14,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="BrandTextPanel" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32"
                                    CornerRadius="8"
                                    Background="AntiqueWhite"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/icon.png"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="آرکانرم‌افزار"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="سکوی امن یادگیری"
                                           Margin="0,1,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="BrandMarkOnly"
                            Width="36" Height="36"
                            CornerRadius="9"
                            Background="AntiqueWhite"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            ToolTip="آرکانرم‌افزار — سکوی امن یادگیری">
                        <Image Source="pack://application:,,,/Assets/icon.png"
                               Stretch="Uniform"
                               Margin="4"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>

                    <Button x:Name="CollapseSidebarButton"
                            Grid.Column="1"
                            Style="{StaticResource ShellIconButtonStyle}"
                            ToolTip="جمع‌کردن منو"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0"
                            Click="CollapseSidebarButton_OnClick">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
                    </Button>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Margin="6,0,6,14">
                    <RadioButton x:Name="AboutNav"
                                 Style="{StaticResource NavButtonStyle}"
                                 GroupName="MainNav"
                                 Tag="About"
                                 ToolTip="درباره ما"
                                 Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" />
                            <TextBlock x:Name="AboutNavLabel" Text="درباره ما" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SettingsNav"
                                 Style="{StaticResource NavButtonStyle}"
                                 GroupName="MainNav"
                                 Tag="Settings"
                                 ToolTip="تنظیمات"
                                 Checked="Nav_Checked"
                                 Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.97 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.52,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.97 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.95C7.96,18.35 8.52,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.48,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z" />
                            <TextBlock x:Name="SettingsNavLabel" Text="تنظیمات" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,4,0,0">
                    <StackPanel Margin="0,4,0,0">
                        <RadioButton x:Name="PlayerNav"
                                     Style="{StaticResource NavButtonStyle}"
                                     GroupName="MainNav"
                                     Tag="Player"
                                     ToolTip="پخش‌کننده"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M8,5.14V19.14L19,12.14L8,5.14Z" />
                                <TextBlock x:Name="PlayerNavLabel" Text="پخش‌کننده" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButtonStyle}"
                                     GroupName="MainNav"
                                     Tag="Messenger"
                                     ToolTip="پیام‌رسان"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M12,3C6.5,3 2,6.58 2,11C2,13.12 3.05,15.07 4.75,16.5C4.75,17.1 4.33,18.67 2,21C4.37,20.89 6.37,20.1 7.82,19.25C9.14,19.72 10.54,20 12,20C17.5,20 22,16.42 22,11C22,6.58 17.5,3 12,3Z" />
                                <TextBlock Text="پیام‌رسان" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButtonStyle}"
                                     GroupName="MainNav"
                                     Tag="RemoteAssist"
                                     ToolTip="کمک از راه دور"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z" />
                                <TextBlock Text="کمک از راه دور" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButtonStyle}"
                                     GroupName="MainNav"
                                     Tag="Downloads"
                                     ToolTip="دانلودها"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" />
                                <TextBlock Text="دانلودها" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ExamsNav"
                                     Style="{StaticResource NavButtonStyle}"
                                     GroupName="MainNav"
                                     Tag="Exams"
                                     ToolTip="آزمون‌ها"
                                     Visibility="Collapsed"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M8,13H16V15H8V13M8,17H13V19H8V17Z" />
                                <TextBlock Text="آزمون‌ها" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <Separator x:Name="ManagementSeparator"
                                   Margin="12,8,12,8"
                                   Visibility="Collapsed" />

                        <RadioButton x:Name="CoursesNav"
                                     Style="{StaticResource NavButtonStyle}"
                                     GroupName="MainNav"
                                     Tag="Courses"
                                     ToolTip="دوره‌ها"
                                     Visibility="Collapsed"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M18,22A2,2 0 0,0 20,20V4A2,2 0 0,0 18,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18M6,4H11V12L8.5,10.5L6,12V4Z" />
                                <TextBlock Text="دوره‌ها" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="StudentsNav"
                                     Style="{StaticResource NavButtonStyle}"
                                     GroupName="MainNav"
                                     Tag="Students"
                                     ToolTip="دانشجویان"
                                     Visibility="Collapsed"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z" />
                                <TextBlock Text="دانشجویان" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TeachersNav"
                                     Style="{StaticResource NavButtonStyle}"
                                     GroupName="MainNav"
                                     Tag="Teachers"
                                     ToolTip="اساتید"
                                     Visibility="Collapsed"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M12,3L1,9L12,15L21,10.09V17H23V9M5,13.18V17.18L12,21L19,17.18V13.18L12,17L5,13.18Z" />
                                <TextBlock Text="اساتید" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="OnlineUsersNav"
                                     Style="{StaticResource NavButtonStyle}"
                                     GroupName="MainNav"
                                     Tag="OnlineUsers"
                                     ToolTip="کاربران آنلاین"
                                     Visibility="Collapsed"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,8.39A2.22,2.22 0 0,1 14.22,10.61A2.22,2.22 0 0,1 12,12.83A2.22,2.22 0 0,1 9.78,10.61A2.22,2.22 0 0,1 12,8.39M8.5,16.5C8.5,14.67 10.84,13.5 12,13.5C13.16,13.5 15.5,14.67 15.5,16.5V17.5H8.5V16.5Z" />
                                <TextBlock Text="کاربران آنلاین" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource BgPrimaryBrush}">
            <ContentControl x:Name="PageHost" Margin="24" />

            <!-- Re-open shell sidebar when fully hidden (e.g. video fullscreen) -->
            <Button x:Name="ShowSidebarFab"
                    Style="{StaticResource ShellIconButtonStyle}"
                    Width="40" Height="40"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,12,0"
                    ToolTip="نمایش منو"
                    Visibility="Collapsed"
                    Panel.ZIndex="20"
                    Click="ShowSidebarFab_OnClick">
                <Border Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Width="40" Height="40">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{StaticResource TextPrimaryBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" />
                </Border>
            </Button>

            <Border x:Name="LoadingOverlay"
                    Background="#E00F1419"
                    Visibility="Collapsed"
                    IsHitTestVisible="True"
                    Panel.ZIndex="30">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            FlowDirection="RightToLeft">
                    <ProgressBar Width="240"
                                 Height="5"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="#334155" />
                    <TextBlock x:Name="LoadingText"
                               Margin="0,18,0,0"
                               Text="در حال بارگذاری..."
                               FontSize="15"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="لطفاً صبر کنید تا اطلاعات آماده شود"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
