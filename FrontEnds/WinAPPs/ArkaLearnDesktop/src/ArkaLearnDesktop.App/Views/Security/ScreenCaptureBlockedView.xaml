<UserControl x:Class="ArkaLearnDesktop.App.Views.Security.ScreenCaptureBlockedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgPrimaryBrush}">
    <Grid>
        <Border MaxWidth="560"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="32"
                Margin="24">
            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <TextBlock Text="{Binding PolicyMessage}"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextAlignment="Center" />

                <TextBlock Text="{Binding AppsHeading}"
                           Margin="0,20,0,8"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <Border Background="{StaticResource BgPrimaryBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        MaxHeight="180">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Threats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding ProcessLabel}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FlowDirection="LeftToRight" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <TextBlock Text="{Binding StatusMessage}"
                           Margin="0,14,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextAlignment="Center" />

                <Button Content="بله، نرم‌افزارها را ببند و ادامه بده"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding CloseAndContinueCommand}"
                        Margin="0,22,0,0"
                        Height="42" />

                <Button Content="بررسی مجدد"
                        Command="{Binding RecheckCommand}"
                        Margin="0,10,0,0"
                        Height="40"
                        Padding="12,8" />

                <Button Content="خروج از برنامه"
                        Command="{Binding ExitCommand}"
                        Margin="0,10,0,0"
                        Height="40"
                        Padding="12,8" />

                <TextBlock Text="اگر بستن خودکار ممکن نباشد، نرم‌افزار را دستی ببندید و «بررسی مجدد» را بزنید."
                           Margin="0,16,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
