<UserControl x:Class="ArkaLearnDesktop.App.Controls.ChatAudioPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220"
             MaxWidth="320"
             Margin="0,8,0,0">
    <Border Background="#1A000000"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PlayPauseButton"
                    Width="36"
                    Height="36"
                    Cursor="Hand"
                    Click="PlayPauseButton_OnClick"
                    ToolTip="پخش / توقف">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="18"
                                Width="36"
                                Height="36">
                            <Path x:Name="Icon"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  Fill="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                  Margin="2,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                <Slider x:Name="ProgressSlider"
                        Minimum="0"
                        Maximum="1"
                        Value="0"
                        IsMoveToPointEnabled="True"
                        PreviewMouseLeftButtonDown="ProgressSlider_OnPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="ProgressSlider_OnPreviewMouseLeftButtonUp"
                        ValueChanged="ProgressSlider_OnValueChanged" />
                <TextBlock x:Name="TimeLabel"
                           Margin="0,2,0,0"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="0:00 / 0:00" />
            </StackPanel>

            <MediaElement x:Name="Media"
                          Grid.Column="2"
                          Width="0"
                          Height="0"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Close"
                          MediaOpened="Media_OnMediaOpened"
                          MediaEnded="Media_OnMediaEnded"
                          MediaFailed="Media_OnMediaFailed" />
        </Grid>
    </Border>
</UserControl>
