<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the Next.js standalone deployment produced by `npm run build:iis` (.iis-dist).

  Routes every request to the Next.js server (server.js) through iisnode, so deep links
  such as /projects/<slug> always reach the app, and passes Node responses through
  unchanged so visitors see the site's own custom 404/500 pages instead of raw IIS
  error pages.

  Server prerequisites: IIS URL Rewrite module + iisnode (see IIS_DEPLOYMENT.md).
  If Node.js is not installed in the default location, add
  nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
  to the <iisnode> element below.

  Do not add file/directory "skip" conditions to the NextJsApp rule: any physical
  folder in the site root (for example a leftover `projects` folder) would then
  shadow app routes and bring back the IIS 404 on project detail pages.
-->
<configuration>
  <system.webServer>

    <handlers>
      <add name="iisnode-next" path="server.js" verb="*" modules="iisnode" resourceType="Unspecified" />
    </handlers>

    <rewrite>
      <rules>
        <!-- www -> apex -->
        <rule name="RedirectWwwToApex" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.arkasoftware\.ir$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://arkasoftware.ir/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- :8443 -> canonical https (443) -->
        <rule name="RedirectPort8443" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{SERVER_PORT}" pattern="^8443$" />
          </conditions>
          <action type="Redirect" url="https://arkasoftware.ir/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- http -> https (skip when a TLS terminating proxy already forwarded https traffic) -->
        <rule name="RedirectHttpToHttps" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
            <add input="{SERVER_PORT}" pattern="^8443$" negate="true" />
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^https$" ignoreCase="true" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- /index.html -> / -->
        <rule name="RedirectIndexHtml" stopProcessing="true">
          <match url="(.*/)?index\.html$" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!--
          Everything else is handled by Next.js. Static assets under /_next/static and
          /public are served by Next itself, so the rule must rewrite unconditionally.
        -->
        <rule name="NextJsApp" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!--
      Pass Node's responses through unchanged. Next.js renders its own custom 404/500
      pages (src/app/not-found.tsx) and IIS must never replace them with its own
      error pages.
    -->
    <httpErrors existingResponse="PassThrough" />

    <iisnode
      nodeProcessCountPerApplication="1"
      debuggingEnabled="false"
      devErrorsEnabled="false"
      loggingEnabled="true"
      loggingDirectory="iisnode-logs"
      flushResponse="true" />

    <directoryBrowse enabled="false" />

  </system.webServer>
</configuration>
